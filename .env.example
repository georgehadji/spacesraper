# OpenAI API key
OPENAI_API_KEY=your-openai-api-key-here

# Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# --- LLM provider selection (Phase 4) ---
# 'gemini' | 'local' | 'noop'
AI_PROVIDER=gemini
# OpenAI-compatible endpoint for a local model (Ollama, llama.cpp server, vLLM).
# Only used when AI_PROVIDER=local. Typically a private address — the adapter
# scopes the SSRF guard's private-IP exemption to exactly this host, never
# a general relaxation.
AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_MODEL=llama3

# Slack webhook (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Demo API key for development/testing
DEMO_API_KEY=demo_key_value_here

# Redis configuration
REDIS_URL=redis://localhost:6379

# Environment
ENVIRONMENT=development

# CORS allowed origins (comma-separated, default: localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Discovery (query-to-URL search) — all default to off/deny ---
# Master switch; NoOp adapter is used until both this and SEARCH_PROVIDER are set.
DISCOVERY_ENABLED=false
# 'noop' | 'duckduckgo' | 'serper'
DISCOVERY_SEARCH_PROVIDER=noop
DISCOVERY_SEARCH_API_KEY=
# JSON array of hostnames, e.g. ["example.com","*.trusted.io"]. Required non-empty to run.
DISCOVERY_ALLOWED_DOMAINS=[]
DISCOVERY_DENIED_DOMAINS=[]
# Discovery-specific fan-out cap, well below the crawl recursion cap (200).
DISCOVERY_MAX_FANOUT=25
DISCOVERY_RESPECT_ROBOTS=true
